# Feishu custom app credentials
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Feishu Bitable app token from its URL/API
LARK_APP_TOKEN=bascnxxxxxxxxxxxxxxxxxxx

# Local PostgreSQL connection string
DATABASE_URL='postgres:///paipai_red?host=/var/run/postgresql&sslmode=disable'

# Standard 5-field cron expression. Default: every 5 minutes.
SYNC_CRON='*/5 * * * *'

# Time zone used to evaluate SYNC_CRON.
SYNC_TIMEZONE=Asia/Shanghai

# Run one synchronization immediately when the service starts.
SYNC_ON_START=true

# Timeout applied to one complete synchronization.
SYNC_TIMEOUT=10m

# Re-fetch linked manuscript content after this interval.
DOCUMENT_REFRESH_INTERVAL=1h

# Xiaohongshu Spotlight OpenAPI application credentials
XHS_JG_APP_ID=12345
XHS_JG_SECRET=replace-with-your-app-secret
XHS_JG_SESSION_FILE='.xhs-jg/session.json'
XHS_JG_AUTHD_LISTEN='127.0.0.1:18080'
XHS_JG_AUTHD_URL='http://127.0.0.1:18080'
XHS_JG_REFRESH_BEFORE=10m
XHS_JG_REFRESH_RETRY=1m

# Business data is refreshed only through the explicit campaign/unit/creativity sync APIs.
# This time zone is used to calculate incremental date windows; it does not schedule jobs.
XHS_JG_SYNC_TIMEZONE=Asia/Shanghai
XHS_JG_SYNC_TIMEOUT=30m

# Guorai account and local Cookie session. The password is never persisted here.
GUORAI_USERNAME='your-account-name'
GUORAI_SESSION_FILE='.guorai/session.json'
